# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# LLM (obrigatório)
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Modelos tentados em ordem quando o principal responde 429 ou 5xx
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
LLM_TEMPERATURE=0.2

# Versionamento e contexto
PROMPT_VERSION=v0.3
CHAT_HISTORY_TURNS=4
# true só em desenvolvimento: inclui arquivos da base com status rascunho
KB_ALLOW_DRAFTS=false

# Groq: fallback do LLM
# Chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=

# Supabase (somente servidor)
SUPABASE_URL=
# Aceita a chave secreta nova (sb_secret_...) ou a legada service_role.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
SIGNED_URL_TTL_SECONDS=

# Sessão e logs: valores aleatórios longos
SESSION_SECRET=
LOG_HASH_SALT=
